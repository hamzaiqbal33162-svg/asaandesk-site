{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pdf-editor/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/pdf-editor/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools/pdf-editor-design",
      "destination": "/tools/pdf-editor",
      "permanent": false
    },
    {
      "source": "/tools/pdf-editor-pro-design",
      "destination": "/tools/pdf-editor-pro",
      "permanent": false
    },
    {
      "source": "/tools/photo-editor-images",
      "destination": "/tools/photo-editor",
      "permanent": false
    },
    {
      "source": "/tools/latest-launches",
      "destination": "/product/launches",
      "permanent": false
    },
    {
      "source": "/tools/visual-suite",
      "destination": "/product/visual-suite",
      "permanent": false
    },
    {
      "source": "/tools/brand-kit",
      "destination": "/product/brand",
      "permanent": false
    },
    {
      "source": "/tools/product-features",
      "destination": "/product/features",
      "permanent": false
    },
    {
      "source": "/tools/apps-marketplace",
      "destination": "/product/apps",
      "permanent": false
    },
    {
      "source": "/tools/templates-marketplace",
      "destination": "/product/templates",
      "permanent": false
    },
    {
      "source": "/tools/all-ai",
      "destination": "/ai",
      "permanent": false
    }
  ]
}